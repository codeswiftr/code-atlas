# =============================================================================
# Code Atlas Frontend - Environment Variables
# Copy to .env: cp .env.example .env
# =============================================================================

# Backend API URL (Code Atlas backend on port 8002)
# Note: Frontend uses proxy in vite.config.ts, these are for reference
# Local: http://localhost:8002
# Production: https://code-atlas-api.up.railway.app
VITE_API_URL=http://localhost:8002

# Forge Core URL (auth/billing - when migrated to unified auth)
# Local: http://localhost:8000
# Production: https://api.codeswiftr.com
VITE_FORGE_CORE_URL=http://localhost:8000
