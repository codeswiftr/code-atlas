# Code Atlas Environment Variables Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files to version control

# ============================================================================
# Anthropic API Configuration
# ============================================================================
# Required for LLM-powered extraction. If not set, pipeline falls back to
# heuristics-only mode (no API costs, lower quality extraction).

# Anthropic API Key (required for LLM extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Alternative auth token name (for compatibility)
# ANTHROPIC_AUTH_TOKEN=sk-ant-...

# Optional: Custom API base URL (defaults to Anthropic's official endpoint)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: Override default model (defaults to claude-3-5-sonnet-latest)
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ============================================================================
# Discovery Configuration
# ============================================================================
# Root directory containing Claude Code project folders
# Default: ~/.claude/projects
CODE_ATLAS_CLAUDE_ROOT=~/.claude/projects

# Optional: Session subdirectory name within projects
# Default: sessions
# CODE_ATLAS_SESSION_DIR=sessions

# Optional: Gitignore-style file for excluding sessions
# CODE_ATLAS_IGNORE_FILE=.code-atlas-ignore

# Maximum session file size in MB (sessions larger than this are skipped)
# Default: 50
CODE_ATLAS_MAX_SESSION_MB=50

# ============================================================================
# Extraction Configuration
# ============================================================================
# Maximum cost per session in USD (enforced before processing)
# Default: 0.02
CODE_ATLAS_MAX_COST_PER_SESSION=0.02

# Maximum cumulative cost per pipeline run in USD
# Default: 10.0
CODE_ATLAS_MAX_CUMULATIVE_COST=10.0

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
# Default: INFO
CODE_ATLAS_LOG_LEVEL=INFO

# ============================================================================
# Notes
# ============================================================================
# - All CODE_ATLAS_* variables can also be set in .code-atlas.toml
# - Environment variables take precedence over TOML file settings
# - See docs/RUNBOOK.md for complete configuration reference
