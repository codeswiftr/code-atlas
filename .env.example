# Code Atlas Environment Configuration
# =====================================
# Copy this file to .env and fill in your values
# DO NOT commit .env files to version control
#
# Quick Start:
#   cp .env.example .env
#   # Edit .env with your API keys
#   make dev

# ============================================================================
# LLM Provider Configuration (choose one)
# ============================================================================

# Option 1: Anthropic (recommended for highest quality)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option 2: OpenRouter (access to multiple models)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=x-ai/grok-3-fast

# Provider selection: "anthropic" or "openrouter"
CODE_ATLAS_LLM_PROVIDER=anthropic

# Note: If no API key is set, the system falls back to heuristics-only mode
# (no API costs, but lower quality extraction)

# ============================================================================
# API Server Configuration
# ============================================================================

# Enable API key authentication (set to true for production)
CODE_ATLAS_API_KEY_REQUIRED=false

# Admin API key for managing other keys (required if API_KEY_REQUIRED=true)
CODE_ATLAS_ADMIN_API_KEY=your-admin-key-here

# Rate limiting (requests per minute)
CODE_ATLAS_RATE_LIMIT=100
CODE_ATLAS_ADMIN_RATE_LIMIT=1000

# Server host and port
CODE_ATLAS_HOST=0.0.0.0
CODE_ATLAS_PORT=8000

# ============================================================================
# Database Configuration
# ============================================================================

# FalkorDB (graph database) - default uses Docker service
CODE_ATLAS_REDIS_URL=redis://localhost:6379

# SQLite database paths (for job persistence and API keys)
CODE_ATLAS_JOB_DB_PATH=data/jobs.db
CODE_ATLAS_API_KEY_DB_PATH=data/api_keys.db

# Create database indexes on startup (recommended)
CODE_ATLAS_CREATE_DB_INDEXES=true

# ============================================================================
# Session Discovery Configuration
# ============================================================================

# Root directory containing Claude Code project folders
CODE_ATLAS_CLAUDE_ROOT=~/.claude/projects

# Maximum session file size in MB (larger sessions are skipped)
CODE_ATLAS_MAX_SESSION_MB=50

# ============================================================================
# Extraction & Cost Configuration
# ============================================================================

# Maximum cost per session in USD
CODE_ATLAS_MAX_COST_PER_SESSION=0.02

# Maximum cumulative cost per pipeline run in USD
CODE_ATLAS_MAX_CUMULATIVE_COST=10.0

# Entity deduplication settings
CODE_ATLAS_ENABLE_DEDUPLICATION=true
CODE_ATLAS_SIMILARITY_THRESHOLD=0.85

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
CODE_ATLAS_LOG_LEVEL=INFO

# Log format: "json" (production) or "console" (development)
CODE_ATLAS_LOG_FORMAT=console

# ============================================================================
# Frontend Configuration (if running separately)
# ============================================================================

# API base URL for frontend
VITE_API_BASE_URL=http://localhost:8000

# ============================================================================
# Development Settings
# ============================================================================

# Enable hot reload for API server
CODE_ATLAS_RELOAD=true

# Enable debug mode (more verbose errors)
CODE_ATLAS_DEBUG=false
