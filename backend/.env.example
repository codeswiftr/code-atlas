# Code Atlas Backend Environment Variables Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files to version control

# ============================================================================
# Anthropic API Configuration
# ============================================================================
# Required for LLM-powered extraction

ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# Discovery Configuration
# ============================================================================
CODE_ATLAS_CLAUDE_ROOT=~/.claude/projects
CODE_ATLAS_MAX_SESSION_MB=50

# ============================================================================
# Extraction Configuration
# ============================================================================
CODE_ATLAS_MAX_COST_PER_SESSION=0.02
CODE_ATLAS_MAX_CUMULATIVE_COST=10.0

# ============================================================================
# Environment & Security
# ============================================================================
# Set to "production" on Railway / any live deployment.
# Drives CORS policy, HSTS headers, and debug mode.
# Values: development | staging | production
CODE_ATLAS_ENV=development

# CORS allowed origins (production only — ignored in development).
# Comma-separated list of exact origin URLs.
# Default (when unset): https://app.codeswiftr.com
# Example: https://app.codeswiftr.com,https://www.codeswiftr.com
CODE_ATLAS_CORS_ORIGINS=https://app.codeswiftr.com

# API key authentication
CODE_ATLAS_API_KEY_REQUIRED=true
CODE_ATLAS_ADMIN_API_KEY=

# ============================================================================
# Logging Configuration
# ============================================================================
CODE_ATLAS_LOG_LEVEL=INFO

# ============================================================================
# Analytics (PostHog)
# ============================================================================
CODE_ATLAS_POSTHOG_API_KEY=
CODE_ATLAS_POSTHOG_HOST=https://eu.posthog.com

# ============================================================================
# Notes
# ============================================================================
# - See root .env.example for complete documentation
# - Configuration can also be set via .code-atlas.toml file
# - See docs/RUNBOOK.md for complete configuration reference
